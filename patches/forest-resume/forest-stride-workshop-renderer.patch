++// authority. A tight enclosing triangle saves fragment work on broad slanted
++// surfaces; the bounds triangle still covers very thin or off-screen sources.
++static void XenoPreferOriginalEdges(const XenoFixedUvVertex* p, XenoFixedUvHeader& h)
++{
++	if (h.left >= h.right) return;
++	const int dx1 = p[1].x - p[0].x, dy1 = p[1].y - p[0].y;
++	const int dx2 = p[2].x - p[0].x, dy2 = p[2].y - p[0].y;
++	const int64_t area = llabs(int64_t(dx1) * dy2 - int64_t(dx2) * dy1);
++	if (!area) return;
++	const int longest = std::max(std::max(abs(dx1) + abs(dy1), abs(dx2) + abs(dy2)),
++		abs(dx1 - dx2) + abs(dy1 - dy2));
++
++	// Moving vertex p by (3*p - sum)*n/256 moves each edge outward by
++	// n*area/(256*edgeL1) in L-infinity distance. More than 1/4 pixel
++	// covers edge ties even after rounding to the minimum GL subpixel grid.
++	const int n = int(64 * longest / area) + 1;
++	if (n > 256) return;
++	const int scale = 256 + 3 * n;
++	const int64_t box = int64_t(h.right - h.left) * (h.bottom - h.top);
++	if (area * scale * scale >= box * 4 * 256 * 256) return;
++	int extent = 0;
++	for (int i = 0; i < 3; ++i)
++		extent = std::max(extent, std::max(abs(int(p[i].x)), abs(int(p[i].y))));
++	// Avoid precision loss at clip planes for distant input vertices.
++	if ((extent + 1) * 256 + 2 * n * longest > 4096 * 256) return;
++
++	h.left = p[0].x + p[1].x + p[2].x;
++	h.top = p[0].y + p[1].y + p[2].y;
++	h.right = 0;
++	h.bottom = -n;
++}
