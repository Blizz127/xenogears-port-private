+        assert(!wire[i]);
+    assert(!PcPort_ForestPartyCapture(bad, (PcPortForestCameraTiming){12, 2}));
+    assert(!PcPort_StreetFollowersCapture(bad));
+
+    taura_setup();
+    ActorData *elly = &scene.actor[2];
+    elly->position.vx = scene.actor[1].position.vx;
+    elly->rotation.vy = (s16)0x8e00;
+    elly->scripts[1].waitTimer = 41;
+    elly->scriptFlags.flags |= 0x400000;
+    elly->flags |= 0x1020;
+    set_word(scene.sprite[2] + 0x80, 3072);
+    memset(D_800B14F0, 0, sizeof D_800B14F0);
+    for (int i = 0; i < TRAIL; ++i)
+        set_wide(D_800B14F0 + i * STRIDE, 0x4000);
+    D_800B2360 = D_800B2364 = D_800B2368 = 0;
+    D_800C3910 = 0;
+    observe(&cold);
+    assert(PcPort_TauraWorkshopPartyRestore(wire));
+    assert_pose(2, &original);
+    assert((u16)elly->rotation.vy == 0x8000);
+    assert(scene.slot[2].pActorData == cold.slots[2].pActorData);
+    assert(scene.slot[2].pSpriteData == cold.slots[2].pSpriteData);
+    assert(elly->characterId == 1);
+    assert(!memcmp(scene.sprite[2] + 0x80, original.sprites[2] + 0x80, 2));
+    assert(elly->scriptFlags.flags == (cold.actors[2].scriptFlags.flags | 0x800u));
+    assert(elly->flags == (cold.actors[2].flags & ~0x1000u));
+    assert(!memcmp(elly->scripts, cold.actors[2].scripts, sizeof elly->scripts));
+    assert(elly->scriptInstructionPointer == cold.actors[2].scriptInstructionPointer);
+    assert_restored_trail(&original);
+    assert(D_800B2360 == 28 && D_800B2364 == 9 && D_800B2368 == 17 && D_800C3910 == -1);
+    for (int i = 0; i < TAURA_ACTORS; ++i) {
