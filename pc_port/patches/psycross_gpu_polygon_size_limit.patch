+/* _xeno_gpu_polygon_size_limit: the PS1 GPU draws nothing for a triangle
+ * whose vertices span 1024+ pixels horizontally or 512+ vertically (quads are
+ * the triangles v0-v1-v2 and v1-v2-v3, tested separately).  PsyCross drew
+ * them, which put spikes across the Xenogears world map at some camera
+ * angles.  A rejected triangle is collapsed onto its first vertex so it
+ * rasterises nothing while the split's vertex count stays as built. */
+#include "../../../../src/gpu_polygon_size_rule.h"
+
+int g_xenoGpuSizeRejected = 0;
+
+static void XenoGpuCollapse(GrVertex* tri)
+{
+	tri[1] = tri[0];
+	tri[2] = tri[0];
+}
+
+static void XenoGpuSizeLimitTriangle(GrVertex* first, VERTTYPE* p0, VERTTYPE* p1, VERTTYPE* p2)
+{
+	if (xeno_gpu_triangle_too_large(p0[0], p0[1], p1[0], p1[1], p2[0], p2[1]))
+	{
+		XenoGpuCollapse(first);
+		g_xenoGpuSizeRejected++;
+	}
+}
+
+/* After TriangulateQuad: [0..2] = v0 v1 v2, [3..5] = v1 v2 v3. */
+static void XenoGpuSizeLimitQuad(GrVertex* first, VERTTYPE* p0, VERTTYPE* p1, VERTTYPE* p2, VERTTYPE* p3)
+{
+	if (xeno_gpu_triangle_too_large(p0[0], p0[1], p1[0], p1[1], p2[0], p2[1]))
+	{
+		XenoGpuCollapse(first);
+		g_xenoGpuSizeRejected++;
+	}
+	if (xeno_gpu_triangle_too_large(p1[0], p1[1], p2[0], p2[1], p3[0], p3[1]))
+	{
+		XenoGpuCollapse(first + 3);
+		g_xenoGpuSizeRejected++;
+	}
+}
+
