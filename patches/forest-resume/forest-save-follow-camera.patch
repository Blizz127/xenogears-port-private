+/* Field 614/e2 after leaving the Disc 2 workshop. Native 09910d26's
+ * ordinary pre-F11 observation supplies both poses. The ring and flags in
+ * motion cases are synthetic, with one distinguishable value in every row. */
+static void workshop_party(void)
+{
+    enum { LEADER = 1, PARTNER = 2, HEADER = 8, POSE = 172, ROW = 48,
+           ROW_LAYER = 44, CURSORS = HEADER + POSE + TRAIL * ROW,
+           TIMING = HEADER + PC_PORT_QUICK_BART_BYTES, PARTY_END = TIMING + 2 };
+    u8 wire[PC_PORT_QUICK_PARTY_BYTES], bad[sizeof wire];
+    struct FieldImage original, entrance;
+    forest_setup();
+    g_GameSceneMapNum = 614;
+    test_script_words[0] = 249;
+    test_script_words[1] = 2;
+    test_script_words[2] = 615;
+    g_FieldNumActors = D_800ADBFC = FOREST_ACTORS;
+    g_PlayerActorIndex = D_8005A444[0] = LEADER;
+    D_8005A444[1] = PARTNER;
+    D_800AFB44[0] = D_800AFB44[1] = 128;
+    pose(LEADER, 0, (VECTOR){46158766, -24248320, -14658642, 0}, 92, 88);
+    pose(PARTNER, 1, (VECTOR){47513600, -24248320, -13303808, 0}, 92, 89);
+    scene.actor[LEADER].scriptFlags.flags = 0x04024430;
+    scene.actor[LEADER].walkmeshId = scene.actor[PARTNER].walkmeshId = 1;
+    ActorData *elly = &scene.actor[PARTNER];
+    elly->rotation = (SVECTOR){-28954, -28954, 3814, 0};
+    elly->scriptFlags.flags = 0x010204b0;
+    elly->flags = 0x04010400;
+    set_word(scene.sprite[PARTNER] + 0x80, (u16)-512);
+    D_800B2360 = 31;
+    D_800B2364 = 10;
+    D_800B2368 = 21;
+    for (int i = 0; i < TRAIL; ++i) {
+        u8 *row = D_800B14F0 + i * STRIDE;
+        set_wide(row, i % 2 ? 0x800 : 0);
+        set_word(row + 8, 704 + i);
+        set_word(row + 0x16, 92);
+        set_word(row + 0x18, 88 + i % 2);
+        row[0x44] = 1;
+    }
+    const PcPortForestCameraTiming timing = {12, 2};
+    PcPortForestCameraTiming restored_timing = {0};
+    memset(wire, 0xa5, sizeof wire);
+    assert(PcPort_ForestPartyCapture(wire, timing));
+    assert(!memcmp(wire, "F614", 4));
+    assert(wire[TIMING] == timing.step && wire[TIMING + 1] == timing.phase);
+    for (size_t i = PARTY_END; i < sizeof wire; ++i)
+        assert(wire[i] == 0);
+    assert(!PcPort_StreetFollowersCapture(bad));
+    assert_rejected(PcPort_StreetFollowersRestore, wire);
+    observe(&original);
+
+    /* The cold constructor put both characters at Fei. Its scheduler state,
+     * bindings and unrelated flags survive applying the saved companion. */
+    pose(PARTNER, 1, scene.actor[LEADER].position, 92, 88);
+    elly->scriptFlags.flags = 0x01420cb0;
+    elly->flags = 0x04011420;
+    elly->scriptInstructionPointer = 0x135;
+    elly->scripts[1].waitTimer = 41;
+    set_word(scene.sprite[PARTNER] + 0x80, 1024);
+    memset(D_800B14F0, 0, sizeof D_800B14F0);
+    for (int i = 0; i < TRAIL; ++i)
+        set_wide(D_800B14F0 + i * STRIDE, 0x4800);
+    D_800B2360 = D_800B2364 = D_800B2368 = 0;
+    D_800C3910 = 0;
+    observe(&entrance);
+    assert(PcPort_ForestPartyRestore(wire, &restored_timing));
+    assert(restored_timing.step == timing.step && restored_timing.phase == timing.phase);
+    assert_pose(PARTNER, &original);
+    assert(elly->position.vx - scene.actor[LEADER].position.vx == 1354834);
+    assert(elly->position.vz - scene.actor[LEADER].position.vz == 1354834);
+    assert(!memcmp(scene.sprite[PARTNER] + 0x80, original.sprites[PARTNER] + 0x80, 2));
+    assert(elly->scriptFlags.flags == 0x014204b0 && elly->flags == 0x04010420);
+    assert(elly->scriptInstructionPointer == entrance.actors[PARTNER].scriptInstructionPointer);
+    assert(!memcmp(elly->scripts, entrance.actors[PARTNER].scripts, sizeof elly->scripts));
+    assert(!memcmp(&scene.actor[LEADER], &entrance.actors[LEADER], sizeof scene.actor[LEADER]));
+    assert(D_800B2360 == 31 && D_800B2364 == 10 && D_800B2368 == 21 && D_800C3910 == -1);
+    assert_restored_trail(&original);
+
+    /* Each malformed payload must fail before changing pose, flags or trail. */
+    const size_t invalid[] = {0, 4, 6, HEADER + POSE - 2, HEADER + POSE - 1,
+        HEADER + POSE + (TRAIL - 1) * ROW + ROW_LAYER, CURSORS + 8, TIMING - 2, TIMING - 1,
+        PARTY_END, sizeof wire - 1};
+    for (size_t i = 0; i < sizeof invalid / sizeof invalid[0]; ++i) {
+        memcpy(bad, wire, sizeof bad);
+        bad[invalid[i]] = 0xff;
+        assert_rejected(restore_workshop_party, bad);
+    }
+    const PcPortForestCameraTiming invalid_timing[] = {{7, 0}, {9, 0}, {22, 0}, {12, 4}};
+    for (size_t i = 0; i < sizeof invalid_timing / sizeof invalid_timing[0]; ++i) {
+        memcpy(bad, wire, sizeof bad);
+        assert(!PcPort_ForestPartyCapture(bad, invalid_timing[i]));
+        assert(!memcmp(bad, wire, sizeof bad));
+        bad[TIMING] = invalid_timing[i].step;
+        bad[TIMING + 1] = invalid_timing[i].phase;
+        assert_rejected(restore_workshop_party, bad);
+    }
+    assert(!PcPort_ForestPartyRestore(wire, NULL));
+    D_8005A444[1] = 1;
+    memset(bad, 0xa5, sizeof bad);
+    assert(!PcPort_ForestPartyCapture(bad, timing));
+    for (size_t i = 0; i < sizeof bad; ++i)
+        assert(bad[i] == 0xa5);
+    assert_rejected(restore_workshop_party, wire);
+    D_8005A444[1] = PARTNER;
+    /* The follower update toggles these bits independently. Capturing a moving
+     * idle-animation follower and clearing either bit must round-trip. */
+    for (unsigned i = 0; i < 4; ++i) {
+        const u16 moving = i & 1 ? 0x800 : 0;
+        const u16 use_trail = i & 2 ? 0x1000 : 0;
