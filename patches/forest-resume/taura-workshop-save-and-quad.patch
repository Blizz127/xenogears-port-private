+    pose(2, 1, (VECTOR){-18677760, 0, 0, 0}, 38, 8);
+    scene.actor[1].scriptFlags.flags = 0x04024430;
+    scene.actor[2].scriptFlags.flags = 0x010204b0;
+    scene.actor[1].scriptInstructionPointer = scene.actor[1].scripts[0].currentIP = 0x55;
+    scene.actor[2].scriptInstructionPointer = scene.actor[2].scripts[0].currentIP = 0xbe;
+    pose(14, 255, (VECTOR){0}, 0, 0);
+    scene.slot[14].status |= ACTOR_STATUS_INVISIBLE;
+    pose(17, 255, (VECTOR){0}, 0, 0);
+    scene.actor[17].scriptFlags.flags |= 1;
+    for (int i = 0; i < TRAIL; ++i) {
+        u8 *row = D_800B14F0 + i * STRIDE;
+        set_wide(row, i % 2 ? 0x800 : 0);
