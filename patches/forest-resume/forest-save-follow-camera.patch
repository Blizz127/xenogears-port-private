+       FOREST_HANDBACK = 0x39a, FOREST_CONTROL_HOLD = 0x3ae };
+
+static int capture_field_follow_camera(uint8_t out[128], int forest_party);
+
+static int forest_controller_parked(int require_control)
+{
+    if (!s_forestScript || g_FieldCurScriptFile != s_forestScript || !g_FieldActors ||
+        D_800ADBFC != FOREST_ACTORS || !g_FieldActors[FOREST_CONTROLLER].pActorData)
+        return 0;
+    const ActorData *controller = (const ActorData *)(uintptr_t)g_FieldActors[FOREST_CONTROLLER].pActorData;
+    if (controller->scripts[0].currentIP != FOREST_CONTROL_HOLD ||
+        controller->scripts[0].flags_0x12 != 7 || D_800B21D0)
+        return 0;
+    return !require_control || (controller->scriptInstructionPointer == FOREST_CONTROL_HOLD &&
+           !g_FieldScriptMemoryU16[0x400 / 2] && D_800ADB68 == 1 && D_800ADB64 == 0xff);
+}
