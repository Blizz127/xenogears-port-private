diff --git a/pc_port/tests/quick_checkpoint_taura_cases.inc b/pc_port/tests/quick_checkpoint_taura_cases.inc
new file mode 100644
index 0000000000000000000000000000000000000000..3755cbe2f01cd450ea96ec94a4b3c5ea2a18b5ee
--- /dev/null
+++ b/pc_port/tests/quick_checkpoint_taura_cases.inc
@@ -0,0 +1,174 @@
+/* The production camera and slot codec run here. The actor codec has its own
+ * field fixture; a tagged heading makes its invocation and order observable. */
+enum { TAURA_TEST_ACTORS = 24, TAURA_TEST_SCRIPT_BYTES = 4400 };
+static FieldActor taura_test_fields[TAURA_TEST_ACTORS];
+static _Alignas(ScriptsFile) u8 taura_test_script[TAURA_TEST_SCRIPT_BYTES];
+static unsigned taura_captures, taura_restores;
+
+int PcPort_TauraWorkshopPartyCapture(uint8_t out[PC_PORT_QUICK_PARTY_BYTES])
+{
+    require(g_GameSceneMapNum == 615 && g_FieldActors == taura_test_fields,
+            "workshop capture dispatched in another field");
+    ++taura_captures;
+    memcpy(out, "W615", 4);
+    memcpy(out + 4, &(g_actor + 1)->rotation.vy, sizeof(s16));
+    return 1;
+}
+
+int PcPort_TauraWorkshopPartyRestore(const uint8_t in[PC_PORT_QUICK_PARTY_BYTES])
+{
+    require(g_GameSceneMapNum == 615 && g_FieldActors == taura_test_fields &&
+            g_actor->position.vx == -17989542 && g_actor->position.vz == 688218,
+            "workshop party dispatched before Fei's saved placement");
+    require(!memcmp(in, "W615", 4), "unrecognized party payload dispatched as W615");
+    ++taura_restores;
+    memcpy(&(g_actor + 1)->rotation.vy, in + 4, sizeof(s16));
+    return 1;
+}
+
+static void taura_test_field(void)
+{
+    g_FieldActors = taura_test_fields;
+    D_800ADBFC = TAURA_TEST_ACTORS;
+    g_GameSceneMapNum = 615;
+    g_PlayerActorIndex = 1;
+    D_800AFB54 = 1; /* Geometry is independently covered by the contact fixture. */
+    taura_test_fields[1].pActorData = (u32)(uintptr_t)g_actor;
+    taura_test_fields[2].pActorData = (u32)(uintptr_t)(g_actor + 1);
+    taura_test_fields[1].status = taura_test_fields[2].status = 0x240;
+    g_FieldCurScriptFile = (ScriptsFile *)taura_test_script;
+    g_FieldScriptVMCurScriptData = taura_test_script + 0x84 + TAURA_TEST_ACTORS * 64;
+    g_actor->scripts[0].currentIP = g_actor->scriptInstructionPointer = 0x55;
+    (g_actor + 1)->scripts[0].currentIP = (g_actor + 1)->scriptInstructionPointer = 0xbe;
+    g_actor->position = (VECTOR){-17989542, 0, 688218, 0};
+    script_word(0, 249);
+    script_word(2, 0);
+    script_word(4, 614);
+    script_word(0x1c0, 0x400);
+    memcpy(g_GameState + 0x1d34, (u8[]){0, 1, 255}, 3);
+    target_z = g_actor->position.vz;
+    target_heading = 1536;
+    g_Scene = (FieldScene){0};
+    g_Scene.sceneScrZ = 512;
+    g_Scene.sceneDIP = 25;
+    g_Scene.sceneScale = 4096;
+    g_Scene.unk7C = g_Scene.sceneAngle.vy = target_heading;
+    memcpy((u8 *)&g_Scene + 0x60, &(s32){1536 * 65536}, sizeof(s32));
+    g_FieldCameraMode = 0;
+    D_800B233E = g_PlayerActorIndex;
+    g_CamMovementFlags = g_CamAtMovementDuration = g_CamEyeMovementDuration = 0;
+    g_CamInterpolation.atStepDistance = g_CamInterpolation.eyeStepDistance = 8;
+    D_800ADBA8 = D_800B21CD = D_800B21D8 = 0;
+    g_CameraEye = (VECTOR){24595548, -30474240, -42818980, 0};
+    g_CameraAt = (VECTOR){-18450596, -2097152, 227164, 0};
+    g_CameraEye2 = target_eye = (VECTOR){25056602, -30474240, -42357926, 0};
+    g_CameraAt2 = target_at = (VECTOR){-17989542, -2097152, 688218, 0};
+}
+
+static void taura_test_save(PcPortQuickCheckpoint *slot)
+{
+    PcPort_QuickCheckpointRequestSave();
+    require(!PcPort_QuickCheckpointPoll() &&
+            PcPort_QuickCheckpointGetUiState() == PC_PORT_QUICK_UI_SAVE_OK &&
+            !PcPort_QuickCheckpointReadFile(g_path, slot), "write and decode workshop F11");
+}
+
+static void taura_test_restore(unsigned script_size, int expected_party)
+{
+    const s16 entry_facing = 0x0800;
+    unsigned previous = taura_restores;
+    load_fixture_slot();
+    taura_test_field();
+    PcPort_QuickCheckpointFieldScriptsReady(script_size);
+    (g_actor + 1)->rotation.vy = entry_facing;
+    g_actor->position.vx = g_actor->position.vz = 0;
+    g_CameraEye.vx = 0;
+    target_calls = matrix_calls = 0;
+    if (expected_party) {
+        D_800B21D0 = 1;
+        PcPort_QuickCheckpointRestorePlayer();
+        require(!g_actor->position.vx && taura_restores == previous, "workshop F12 bypassed event lock");
+        D_800B21D0 = 0;
+        g_FieldCameraMode = 2;
+        require(!PcPort_QuickCheckpointPoll() && !g_actor->position.vx && taura_restores == previous,
+                "workshop F12 bypassed camera ownership");
+        g_FieldCameraMode = 0;
+        require(!PcPort_QuickCheckpointPoll(), "workshop F12 retry started a new field");
+    } else {
+        PcPort_QuickCheckpointRestorePlayer();
+    }
+    PcPort_QuickCheckpointRestorePlayer();
+    require(g_actor->position.vx == -17989542 && g_actor->position.vz == 688218 &&
+            g_CameraEye.vx == 24595548 && matrix_calls == 1,
+            "workshop F12 lost Fei or the original follow camera");
+    require(taura_restores == previous + (unsigned)expected_party &&
+            (g_actor + 1)->rotation.vy == (expected_party ? (s16)0x8000 : entry_facing),
+            "workshop F12 substituted a party or guessed missing facing");
+}
+
+static void test_taura_workshop_party(void)
+{
+    const char *path = getenv("XENO_QUICK_TEST_TAURA_SCRIPT");
+    PcPortQuickCheckpoint legacy, saved;
+    reset_case();
+    mounted_disc = 2;
+    taura_test_field();
+    g_FieldCurScriptFile->numScripts = TAURA_TEST_ACTORS;
+    PcPort_QuickCheckpointFieldScriptsReady(0);
+    taura_test_save(&legacy);
+    require(legacy.field_actor_kind == PC_PORT_QUICK_ACTORS_FOLLOW_CAMERA && legacy.has_field_camera &&
+            !legacy.has_party_followers && !taura_captures, "unidentified workshop captured a party");
+    taura_test_restore(0, 0);
+
+    if (path) {
+        FILE *file = fopen(path, "rb");
+        require(file && fread(taura_test_script, 1, sizeof taura_test_script, file) == sizeof taura_test_script &&
+                fgetc(file) == EOF && !ferror(file) && fclose(file) == 0, "read supplied field 615 script");
+        taura_test_field();
+        PcPort_QuickCheckpointFieldScriptsReady(sizeof taura_test_script);
+        (g_actor + 1)->rotation.vy = (s16)0x8000;
+        taura_test_save(&saved);
+        require(saved.field_actor_kind == PC_PORT_QUICK_ACTORS_FOLLOW_CAMERA && saved.has_party_followers &&
+                !memcmp(saved.party_followers, "W615", 4) && taura_captures == 1,
+                "identified workshop F11 omitted W615 or its FCV1");
+        taura_test_restore(sizeof taura_test_script, 1);
+        taura_test_restore(0, 0);
+        taura_test_script[0] ^= 1;
+        taura_test_restore(sizeof taura_test_script, 0);
+        taura_test_script[0] ^= 1;
+
+        char party_path[1024];
+        require(snprintf(party_path, sizeof party_path, "%s.bart", g_path) < (int)sizeof party_path,
+                "workshop party fixture path");
+        FILE *damaged = fopen(party_path, "r+b");
+        require(damaged && !fseek(damaged, -1, SEEK_END), "open workshop party checksum");
+        int byte = fgetc(damaged);
+        require(byte != EOF && !fseek(damaged, -1, SEEK_END) && fputc(byte ^ 1, damaged) != EOF &&
+                !fclose(damaged), "damage only the workshop party checksum");
+        taura_test_restore(sizeof taura_test_script, 0);
+
+        require(!PcPort_QuickCheckpointWriteFile(g_path, &legacy), "write legacy workshop FCV1");
+        taura_test_restore(sizeof taura_test_script, 0);
+        PcPortQuickCheckpoint wrong_story = saved;
+        camera_game_word(&wrong_story, 0x1af0, 0x1400);
+        require(!PcPort_QuickCheckpointWriteFile(g_path, &wrong_story), "write later workshop story");
+        taura_test_restore(sizeof taura_test_script, 0);
+        memcpy(saved.party_followers, "OLD?", 4);
+        require(!PcPort_QuickCheckpointWriteFile(g_path, &saved), "write unknown workshop payload");
+        taura_test_restore(sizeof taura_test_script, 0);
+        taura_test_field();
+        PcPort_QuickCheckpointFieldScriptsReady(sizeof taura_test_script);
+        g_Scene.sceneScrZ = 0;
+        taura_test_save(&saved);
+        require(!saved.has_party_followers && !saved.field_actor_kind && taura_captures == 1,
+                "workshop party captured without a complete FCV1");
+        puts("QUICK GATE Disc 2 workshop W615 F11/F12, script identity and legacy FCV1: PASS");
+    } else {
+        puts("QUICK GATE original workshop W615 not run (set XENO_QUICK_TEST_TAURA_SCRIPT)");
+    }
+    g_FieldCurScriptFile = &test_script_file;
+    g_FieldScriptVMCurScriptData = test_music_script;
+    D_800AFB54 = 2;
+    mounted_disc = 1;
+    reset_case();
+}
