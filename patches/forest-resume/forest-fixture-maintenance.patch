diff --git a/pc_port/tests/run_quick_checkpoint_gate_test.sh b/pc_port/tests/run_quick_checkpoint_gate_test.sh
index 28dcc85cc92d28b0ad2c8b8c4c85b75b64cbd857..b41a29610170d496c7149f4a9e1d201cf918ae8d 100755
--- a/pc_port/tests/run_quick_checkpoint_gate_test.sh
+++ b/pc_port/tests/run_quick_checkpoint_gate_test.sh
@@ -8,4 +8,2 @@
-  # The positive tank-room case uses the owner's field script without retaining
-  # any disc bytes in the test suite.
-  export XENO_QUICK_TEST_TANK_SCRIPT="$out/field616.script"
-  PYTHONDONTWRITEBYTECODE=1 python3 - "$XENO_DISC2" "$XENO_QUICK_TEST_TANK_SCRIPT" <<'PY'
+  # Extract the two original field scripts into test-local temporary storage.
+  PYTHONDONTWRITEBYTECODE=1 python3 - "$XENO_DISC2" "$out" <<'PY'
@@ -20 +18,4 @@
-    package = disc.read_entry(FIELD_MAP_FIRST_ENTRY + 2 * 616)
+    for field in (614, 616):
+        package = disc.read_entry(FIELD_MAP_FIRST_ENTRY + 2 * field)
+        script = lzss_decompress(package[u32(package, 0x144):])
+        (Path(sys.argv[2]) / f"field{field}.script").write_bytes(script)
@@ -23,2 +23,0 @@
-script = lzss_decompress(package[u32(package, 0x144):])
-Path(sys.argv[2]).write_bytes(script)
@@ -25,0 +25,2 @@
