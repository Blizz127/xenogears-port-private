--- a/pc_port/tests/quick_checkpoint_gate_test.c
+++ b/pc_port/tests/quick_checkpoint_gate_test.c
@@ -1582,0 +1583 @@
+#include "quick_checkpoint_forest_cases.inc"
@@ -1869,0 +1871 @@
+    test_forest_handback();
