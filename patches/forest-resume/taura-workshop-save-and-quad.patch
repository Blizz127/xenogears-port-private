diff --git a/pc_port/tests/psycross_texture_modulation_test.cpp b/pc_port/tests/psycross_texture_modulation_test.cpp
index b84cccbf8e5dc077d9f5cca8c6f84ba02d784e32..00ea282d2bb74dc2c8d0a1cdd9721e1766732dc7 100644
--- a/pc_port/tests/psycross_texture_modulation_test.cpp
+++ b/pc_port/tests/psycross_texture_modulation_test.cpp
@@ -287,0 +288,32 @@ static bool covered(const std::array<std::array<int,2>,3>& triangle, int x, int
+// Each folded raw quad has a sample in both halves and one in each half
+// alone. A zero texel in the last half must expose the earlier half.
+static bool runRawQuadOverlap() {
+    for (int mirror = 0; mirror < 4; ++mirror) {
+        auto x = [mirror](int v) { return mirror & 1 ? size - 1 - v : v; };
+        auto y = [mirror](int v) { return mirror & 2 ? size - 1 - v : v; };
+        POLY_FT4 quad{};
+        quad.code = 0x2d;
+        quad.tpage = directPage;
+        quad.x0 = x(8);  quad.y0 = y(52);
+        quad.x1 = x(4);  quad.y1 = y(4);
+        quad.x2 = x(56); quad.y2 = y(4);
+        quad.x3 = x(46); quad.y3 = y(48);
+        quad.u3 = 24;
+        for (unsigned short front : {0x001f, 0x0000}) {
+            const unsigned short back = 0x03e0;
+            std::vector<unsigned short> texture(32, back);
+            texture[0] = front;
+            uploadTexture(texture, 32, 1);
+            clearScene(0,0,0);
+            if (!drawPacket(reinterpret_cast<P_TAG*>(&quad)) || g_vertexIndex != 6 ||
+                !verifyPixel("FT4 overlapping halves", x(24),y(24),front ? front : back) ||
+                !verifyPixel("FT4 first half alone", x(9),y(40),front) ||
+                !verifyPixel("FT4 second half alone", x(43),y(34),back) ||
+                !verifyPixel("FT4 outside", x(62),y(60),0))
+                return false;
+        }
+    }
+    puts("PASS raw opaque quad draw order across both axes and transparent texels");
+    return true;
+}
+
@@ -382 +414 @@ int main(int argc, char** argv) {
-        ok = runFieldCoverage();
+        ok = runFieldCoverage() && runRawQuadOverlap();
