@@ -271,0 +272,73 @@ static bool runFilterControl() {
+// Independent scan conversion at integer screen samples. The left edge belongs
+// to a triangle, the right edge belongs to its neighbor; bottom rows are open.
+static bool covered(const std::array<std::array<int,2>,3>& triangle, int x, int y) {
+    int intersections = 0, rightOfSample = 0;
+    for (int edge = 0; edge < 3; ++edge) {
+        auto a = triangle[edge], b = triangle[(edge+1)%3];
+        if (a[1] > b[1]) std::swap(a,b);
+        if (y < a[1] || y >= b[1]) continue;
+        const int height = b[1] - a[1];
+        const int edgeX = a[0]*height + (b[0]-a[0])*(y-a[1]);
+        ++intersections;
+        if (x*height < edgeX) ++rightOfSample;
+    }
+    return intersections == 2 && rightOfSample == 1;
+}
+
+static bool runFieldCoverage() {
+    using Triangle = std::array<std::array<int,2>,3>;
+    static const Triangle triangles[] = {
+        {{{4,8},{61,8},{8,61}}}, {{{61,8},{61,61},{8,61}}},
+        {{{32,-10},{33,4},{28,61}}}, {{{49,50},{28,61},{33,4}}},
+        {{{6,5},{60,54},{35,31}}}, {{{47,5},{49,6},{17,41}}},
+        {{{-17,-15},{79,59},{35,25}}}, {{{10,23},{35,16},{153,-17}}}
+    };
+    uploadTexture({0x7fff},1,1);
+    for (const auto& tri : triangles) {
+        for (int winding : {1,2}) {
+            clearScene(0,0,0);
+            POLY_FT3 p{};
+            p.code = 0x25; p.tpage = directPage;
+            p.x0 = tri[0][0]; p.y0 = tri[0][1];
+            p.x1 = tri[winding][0]; p.y1 = tri[winding][1];
+            p.x2 = tri[3-winding][0]; p.y2 = tri[3-winding][1];
+            if (!drawPacket((P_TAG*)&p)) return false;
+            Image image;
+            glReadPixels(0,0,size,size,GL_RGBA,GL_UNSIGNED_BYTE,image.data());
+            for (int y=0; y<size; ++y) for (int x=0; x<size; ++x) {
+                const int actual = rgb555(image[(size-1-y)*size+x]);
+                const int expected = covered(tri,x,y) ? 0x7fff : 0;
+                if (actual != expected) {
+                    fprintf(stderr,"Field triangle %td, winding %d at (%d,%d): %04x, wanted %04x\n",
+                            &tri-triangles,winding,x,y,actual,expected);
+                    return false;
+                }
+            }
+        }
+    }
+    // Sample a varying triangle at its vertices and interior. The interpolation
+    // plane still belongs to the original vertices when the coverage box changes.
+    clearScene(0,0,0);
+    POLY_GT3 shaded{};
+    shaded.code = 0x34; shaded.tpage = directPage;
+    shaded.x0 = 7; shaded.y0 = 3; shaded.r0 = 96; shaded.g0 = 32; shaded.b0 = 64;
+    shaded.x1 = 39; shaded.y1 = 3; shaded.r1 = 32; shaded.g1 = 96; shaded.b1 = 64;
+    shaded.x2 = 7; shaded.y2 = 35; shaded.r2 = 96; shaded.g2 = 32; shaded.b2 = 128;
+    if (!drawPacket((P_TAG*)&shaded)) return false;
+    for (int dy=0; dy<32; ++dy) for (int dx=0; dx<32-dy; ++dx) {
+        const int gain[] = {96-2*dx,32+2*dx,64+2*dy};
+        const auto observed = pixel(7+dx,3+dy);
+        for (int c=0; c<3; ++c) {
+            // RGBA8 conversion rounds the normalized (248/255)*(2*gain/255).
+            const int target = (248*2*gain[c]+127)/255;
+            if (abs((int)observed[c]-target) > 1) {
+                fprintf(stderr,"Field Gouraud plane (%d,%d), channel %d: %u, wanted %d\n",
+                        dx+7,dy+3,c,observed[c],target);
+                return false;
+            }
+        }
+    }
+    puts("PASS textured field polygon scanline coverage for both windings");
+    return true;
+}
+
