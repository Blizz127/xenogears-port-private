@@ -0,0 +1,24 @@
+diff --git a/src/gpu/PsyX_GPU.cpp b/src/gpu/PsyX_GPU.cpp
+--- a/src/gpu/PsyX_GPU.cpp
++++ b/src/gpu/PsyX_GPU.cpp
+@@ -1292,3 +1292,18 @@ static int TriangulatePolygonQuad(const Polygon* poly)
+-	TriangulateQuad();
+-	return 6;
++	if (poly->code == 0x2d)
++	{
++		// _xeno_raw_ft4_order: the raw opaque quad draws 1,2,3 before
++		// 0,1,2. Both halves can cover a sample when the quad folds.
++		// MakeVertexQuad stored the incoming vertices in order 0,1,3,2.
++		GrVertex* v = &g_vertexBuffer[g_vertexIndex];
++		v[5] = v[3];
++		v[4] = v[1];
++		v[3] = v[0];
++		v[0] = v[1];
++		v[1] = v[5];
++	}
++	else
++	{
++		TriangulateQuad();
++	}
++	return 6;
+ }
